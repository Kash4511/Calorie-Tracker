# Absolute URL of your Django backend (include trailing slash is OK, we strip it).
# In dev with Vite proxy, you can comment this out and Vite will proxy /api -> 127.0.0.1:8000.
# For production builds, if this is unset the app falls back to the Render backend
# (https://calorie-tracker-gfaz.onrender.com/api) directly, so login/register work
# even when Vercel rewrites are not applied.
# Example:
# VITE_API_URL=https://calorie-tracker-gfaz.onrender.com
#
# Override the Vite proxy target (dev only):
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
